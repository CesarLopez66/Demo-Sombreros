# =============================================================================
# Variables de entorno — copiar a .env.local (nunca commitear valores reales)
# =============================================================================

# --- Supabase (público: lo usa el navegador / PWA) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Supabase (solo servidor: server actions del ERP, microservicio fiscal) ---
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- PostgreSQL ---------------------------------------------------------------
# Pooler en modo TRANSACCIÓN, puerto 6543 → funciones serverless de Vercel.
# En modo transacción no hay prepared statements: el cliente usa prepare:false.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Conexión DIRECTA, puerto 5432 → migraciones (supabase db push) y procesos
# de larga vida (microservicio NestJS en el VPS: LISTEN/NOTIFY de cola_fiscal).
DIRECT_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# --- PowerSync (Fase 2) -------------------------------------------------------
NEXT_PUBLIC_POWERSYNC_URL=https://<instance>.powersync.journeyapps.com

# --- Microservicio fiscal SIN (Fase 3, solo en el VPS) ------------------------
# SIN_CERT_P12_B64=<certificado .p12 en base64, cifrado con SIN_CERT_KEK>
# SIN_CERT_KEK=<clave de cifrado del certificado>
# SIN_CERT_PASSWORD=<contraseña del .p12>
# SIN_TOKEN_DELEGADO=<token API del SIN>
# REDIS_URL=redis://...
